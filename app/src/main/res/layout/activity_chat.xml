<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootChatLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/foundit_background">

    <!-- Chat Header Bar -->
    <LinearLayout
        android:id="@+id/chatHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:background="@color/foundit_surface"
        android:elevation="2dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/abc_ic_ab_back_material"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            app:tint="@color/foundit_primary"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/tvChatWith"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="@color/foundit_text_primary"
                android:singleLine="true"/>

            <TextView
                android:id="@+id/tvChatMatch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/foundit_text_secondary"
                android:textSize="12sp"
                android:singleLine="true"
                android:layout_marginTop="1dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false"/>

    <!-- Bottom Message Composer Container -->
    <LinearLayout
        android:id="@+id/bottomChatContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/foundit_surface"
        android:elevation="4dp">

        <!-- Pending Item Report Card Preview -->
        <LinearLayout
            android:id="@+id/layoutPendingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_rounded"
            android:backgroundTint="@color/foundit_surface_elevated"
            android:padding="8dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivPendingImage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_rounded"
                android:src="@android:drawable/ic_menu_gallery"
                android:contentDescription="Pending Thumbnail"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <TextView
                    android:id="@+id/tvPendingBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:background="@drawable/bg_blue_button"
                    android:text="LOST"/>

                <TextView
                    android:id="@+id/tvPendingName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/foundit_text_primary"
                    android:singleLine="true"
                    android:layout_marginTop="2dp"
                    android:text="Item Name"/>

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnRemovePending"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Remove Attachment"
                app:tint="@color/foundit_text_muted"
                android:padding="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Type a message..."
                android:background="@drawable/bg_rounded"
                android:backgroundTint="@color/foundit_surface_elevated"
                android:textColor="@color/foundit_text_primary"
                android:textColorHint="@color/foundit_text_muted"
                android:padding="14dp"
                android:maxLines="4"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btnSend"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="SEND"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/foundit_primary"
                android:layout_marginStart="10dp"
                android:stateListAnimator="@null"
                app:elevation="0dp"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
