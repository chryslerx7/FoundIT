<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootMyReportsLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/foundit_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer">

        <!-- Containerless Restrained Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Reports"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/foundit_text_primary"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manage the items you've reported."
                android:textSize="13sp"
                android:textColor="@color/foundit_text_secondary"/>
        </LinearLayout>

        <!-- Tabs Bar -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="0dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/foundit_surface"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btnTabLost"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="LOST"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/foundit_primary"
                    android:textColor="@android:color/white"
                    app:elevation="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="2dp"
                    android:layout_marginEnd="3dp"/>

                <Button
                    android:id="@+id/btnTabFound"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="FOUND"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/foundit_surface_elevated"
                    android:textColor="@color/foundit_text_primary"
                    app:elevation="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="2dp"
                    android:layout_marginHorizontal="2dp"/>

                <Button
                    android:id="@+id/btnTabResolved"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="RESOLVED"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/foundit_surface_elevated"
                    android:textColor="@color/foundit_text_primary"
                    app:elevation="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="2dp"
                    android:layout_marginHorizontal="2dp"/>

                <Button
                    android:id="@+id/btnTabDrafts"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="DRAFTS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/foundit_surface_elevated"
                    android:textColor="@color/foundit_text_primary"
                    app:elevation="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="2dp"
                    android:layout_marginStart="3dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Content Frame -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeMyReportsRefresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerMyReports"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:clipToPadding="false"/>

                <ProgressBar
                    android:id="@+id/progressMyReports"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/foundit_primary"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvEmptyMyReports"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You have not submitted any reports yet."
                    android:textColor="@color/foundit_text_secondary"
                    android:layout_gravity="center"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvErrorMyReports"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Failed to load your reports."
                    android:textColor="@color/foundit_lost"
                    android:layout_gravity="center"
                    android:visibility="gone"/>

            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <include
        android:id="@+id/bottomNavContainer"
        layout="@layout/layout_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
