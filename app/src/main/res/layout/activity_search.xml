<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootSearchLayout"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
            <EditText android:id="@+id/etSearch" android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:hint="Search by item name..." android:singleLine="true"
                android:background="@drawable/bg_rounded" android:padding="12dp"/>
            <Button android:id="@+id/btnSearch" android:layout_width="wrap_content" android:layout_height="48dp"
                android:text="Search" android:layout_marginStart="8dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginHorizontal="16dp" android:layout_marginBottom="8dp">
            <Spinner android:id="@+id/spType" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:entries="@array/type_array"/>
            <Spinner android:id="@+id/spCategory" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:entries="@array/search_category_array"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnDateFilter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="?android:attr/buttonStyleSmall"
                android:text="Filter by Date: All" />

            <Button
                android:id="@+id/btnClearDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="?android:attr/buttonStyleSmall"
                android:text="Clear Date"
                android:layout_marginStart="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerSearch"
                android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp"/>
            <ProgressBar android:id="@+id/progressSearch" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone"/>
            <TextView android:id="@+id/tvEmptySearch" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="No matching items found."
                android:layout_gravity="center" android:visibility="gone"/>
            <TextView android:id="@+id/tvErrorSearch" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Failed to load search results."
                android:layout_gravity="center" android:visibility="gone"/>
        </FrameLayout>

    </LinearLayout>

    <include
        android:id="@+id/bottomNavContainer"
        layout="@layout/layout_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
