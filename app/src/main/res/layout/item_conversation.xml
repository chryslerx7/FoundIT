<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/foundit_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvConvUser"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/foundit_text_primary"
                android:singleLine="true"/>

            <TextView
                android:id="@+id/tvConvItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/foundit_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvConvLastMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/foundit_text_secondary"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
