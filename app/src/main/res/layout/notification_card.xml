<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="16dp" android:layout_marginBottom="10dp"
    android:background="@drawable/bg_rounded">
    <TextView android:id="@+id/tvNotificationTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textStyle="bold" android:textSize="16sp"/>
    <TextView android:id="@+id/tvNotificationMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp"/>
</LinearLayout>
